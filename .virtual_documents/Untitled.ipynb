#histogram
import numpy as np
import matplotlib.pyplot as plt
np.random.seed(0)
scores = np.random.normal(70,10,100)
plt.hist(scores,color='skyblue',edgecolor = 'black' , bins=15)
plt.xlabel("Scores")
plt.ylabel("Frequency")
plt.title("Distribution of Exam Scores")
plt.show()




